{
  "expo": {
    "name": "Union Hub",
    "slug": "union-hub",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "unionhub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.phoenixholmes.unionhub",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Union Hub with Face ID."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D3B6E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.phoenixholmes.unionhub"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/startup-logo.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/startup-logo.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Union Hub with Face ID."
        }
      ],
      "./plugins/with-foldable-support"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
